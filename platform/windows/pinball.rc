/* resources of the Windows front-end: icon, version, manifest */
#include <winver.h>

1 ICON "../../build/pinball.ico"
1 24 "pinball.manifest"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Reinhard Sharapov"
      VALUE "FileDescription", "Pinball NS - Pokemon Pinball, the whole table on one screen"
      VALUE "FileVersion", "2.0"
      VALUE "InternalName", "PinballNS"
      VALUE "LegalCopyright", "Made by Reinhard Sharapov 2026. Pokemon Pinball: Copyright 1995-1999 Nintendo, Creatures Inc., GAME FREAK inc., Copyright 1999 HAL Laboratory, Inc., Jupiter Corp."
      VALUE "LegalTrademarks", "Pokemon, Pokemon character names, Game Boy and Game Boy Color are trademarks of Nintendo."
      VALUE "OriginalFilename", "PinballNS.exe"
      VALUE "ProductName", "Pinball NS"
      VALUE "ProductVersion", "2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
